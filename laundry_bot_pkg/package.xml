<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>laundry_bot</name>
  <version>0.1.0</version>
  <description>
    ROS 2 nodes for the laundry bot: MKS CAN arm driver, Quest 2 VR teleop
    (IK), and LeRobot-format teleoperation data recorder.
  </description>
  <maintainer email="padendavis@gmail.com">Paden</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>laundry_bot_interfaces</depend>
  <depend>python3-can</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>cv-bridge</exec_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
